DATABASE_URL="postgresql://postgres:postgres@localhost:5432/deck_it"
REDIS_URL="redis://localhost:6379"

# 默认本地模式。
# 切换为 "multi" 时使用 千问 + DeepSeek + 豆包 的分能力路由；
# 切换为 "doubao" 时使用旧的单 provider 兼容路径。
AI_PROVIDER="mock"

# 多模型路由示例：
# AI_PROVIDER="multi"
#
# 视觉能力：户型图分析
# VISION_PROVIDER="qwen"
# VISION_API_KEY=""
# VISION_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
# VISION_MODEL="qwen3-vl-plus"
#
# 文本能力：设计师追问 + 方案文案生成
# TEXT_PROVIDER="deepseek"
# TEXT_API_KEY=""
# TEXT_BASE_URL="https://api.deepseek.com"
# TEXT_MODEL="deepseek-v4-pro"
#
# 图片能力：Seedream 效果图生成
# IMAGE_PROVIDER="doubao"
# IMAGE_API_KEY=""
# IMAGE_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
# IMAGE_MODEL=""
# IMAGE_SIZE="2048x2048"
#
# 图片能力旧变量回退链：
# IMAGE_API_KEY -> DOUBAO_API_KEY -> ARK_API_KEY
# IMAGE_MODEL -> SEEDREAM_MODEL
# IMAGE_SIZE -> SEEDREAM_SIZE

# 旧单 provider 兼容配置：
# AI_PROVIDER="doubao"
DOUBAO_API_KEY=""
ARK_API_KEY=""
DOUBAO_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
DOUBAO_CHAT_MODEL=""
DOUBAO_VISION_MODEL=""
SEEDREAM_MODEL=""
SEEDREAM_SIZE="2048x2048"
